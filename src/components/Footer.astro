---
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-grid">
		<div>
			<p class="footer-brand">TCA SAFEWORK</p>
			<p class="footer-tagline">Un singur furnizor pentru SSM, PSI / SU</p>
			<p class="footer-seo">
				Serviciu extern SSM abilitat ITM București · PSI / situații de urgență · acoperire națională
			</p>
		</div>
		<div>
			<p class="footer-label">Contact</p>
			<a href="tel:+40762682850">0762 682 850</a>
			<a href="tel:+40763693715">0763 693 715</a>
			<a href="mailto:office@fiscontsrl.ro">office@fiscontsrl.ro</a>
			<span class="footer-address">Bd. Unirii nr. 64, Bl. K4, sc. 4, et. 3, București</span>
		</div>
		<div>
			<p class="footer-label">Navigare</p>
			<a href={`${base}servicii/`}>Servicii</a>
			<a href={`${base}despre/`}>Despre</a>
			<a href={`${base}contact/`}>Contact</a>
			<a href="https://www.facebook.com/profile.php?id=61591444305432" target="_blank" rel="noopener noreferrer"
				>Facebook</a
			>
		</div>
	</div>
	<div class="container footer-bottom">
		<p>© {year} TCA SAFEWORK. Toate drepturile rezervate.</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 2rem;
		background: linear-gradient(160deg, #1a1614 0%, #2c221c 55%, #3a2a22 100%);
		color: rgba(255, 255, 255, 0.82);
		padding: 3.5rem 0 1.5rem;
	}

	.footer-grid {
		display: grid;
		grid-template-columns: 1.4fr 1fr 1fr;
		gap: 2rem;
		padding-bottom: 2.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}

	.footer-brand {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.15rem;
		color: var(--color-white);
		margin-bottom: 0.4rem;
	}

	.footer-tagline {
		color: var(--color-yellow);
		font-weight: 600;
		margin: 0 0 0.65rem;
	}

	.footer-seo {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.45;
		color: rgba(255, 255, 255, 0.55);
		max-width: 28rem;
	}

	.footer-label {
		font-family: var(--font-display);
		font-size: 0.78rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-gold);
		margin-bottom: 0.75rem;
	}

	.footer-grid a {
		display: block;
		text-decoration: none;
		margin-bottom: 0.45rem;
		color: rgba(255, 255, 255, 0.82);
		transition: color 0.2s var(--ease);
	}

	.footer-grid a:hover {
		color: var(--color-sky);
	}

	.footer-address {
		display: block;
		margin-top: 0.35rem;
		font-size: 0.92rem;
		line-height: 1.4;
		color: rgba(255, 255, 255, 0.65);
	}

	.footer-bottom {
		padding-top: 1.25rem;
		font-size: 0.88rem;
		color: rgba(255, 255, 255, 0.55);
	}

	@media (max-width: 760px) {
		.footer-grid {
			grid-template-columns: 1fr;
			gap: 1.75rem;
		}
	}
</style>
