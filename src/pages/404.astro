---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
	title="Pagină negăsită"
	description="Pagina solicitată nu există pe tcasafework.ro."
	robots="noindex, follow"
	canonicalPath="/"
>
	<section class="page-hero">
		<div class="container reveal">
			<span class="eyebrow">404</span>
			<h1>Pagina nu a fost găsită</h1>
			<p>Linkul este greșit sau pagina a fost mutată. Reveniți la pagina principală sau cereți o ofertă.</p>
			<div class="actions">
				<a class="btn btn-primary" href={base}>Acasă</a>
				<a class="btn btn-secondary" href={`${base}contact/`}>Contact</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 4.5rem 0 5rem;
	}

	.page-hero h1 {
		font-size: clamp(2rem, 4.5vw, 3rem);
		max-width: 16ch;
	}

	.page-hero p {
		max-width: 38rem;
		color: var(--color-muted);
		font-size: 1.08rem;
		margin-bottom: 1.5rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
	}
</style>
