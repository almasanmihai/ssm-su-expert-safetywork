---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Contact"
	description="Solicită oferta Expert SafetyWork pentru SSM și PSI / SU. Răspuns în maximum 24 de ore."
>
	<section class="page-hero">
		<div class="container reveal">
			<span class="eyebrow">Contact</span>
			<h1>Solicită oferta</h1>
			<p>
				Ne sunați și spuneți-ne câți angajați aveți. În maximum 24 de ore primiți oferta exactă, fără
				obligații.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container contact-panel reveal">
			<ul class="contact-list">
				<li>
					<span>Telefon</span>
					<a href="tel:+40762682850">0762 682 850</a>
				</li>
				<li>
					<span>Telefon</span>
					<a href="tel:+40763693715">0763 693 715</a>
				</li>
				<li>
					<span>Facebook</span>
					<a href="https://www.facebook.com/profile.php?id=61591444305432" target="_blank" rel="noopener noreferrer"
						>SSM &amp; SU Expert SafetyWork</a
					>
				</li>
			</ul>
			<p class="hint">
				Pentru ofertă ne ajută: domeniul de activitate, numărul de angajați și locația. La control ITM, suntem
				acolo.
			</p>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 3.5rem 0 1rem;
	}

	.page-hero h1 {
		font-size: clamp(2rem, 4.5vw, 3rem);
	}

	.page-hero p {
		max-width: 38rem;
		color: var(--color-muted);
		font-size: 1.08rem;
	}

	.contact-panel {
		max-width: 38rem;
	}

	.contact-list {
		list-style: none;
		margin: 0 0 1.5rem;
		padding: 0;
		display: grid;
		gap: 1.35rem;
	}

	.contact-list li {
		display: grid;
		gap: 0.25rem;
		padding-bottom: 1.25rem;
		border-bottom: 1px solid rgba(110, 58, 40, 0.12);
	}

	.contact-list li:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}

	.contact-list span {
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--color-brown);
	}

	.contact-list a {
		font-size: 1.25rem;
		font-weight: 700;
		text-decoration: none;
		color: var(--color-ink);
	}

	.contact-list a:hover {
		color: var(--color-brown);
	}

	.hint {
		color: var(--color-muted);
		font-size: 0.98rem;
		margin: 0;
		padding-top: 0.5rem;
	}
</style>
