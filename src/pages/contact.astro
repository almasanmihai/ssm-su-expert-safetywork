---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
	title="Contact — solicită oferta SSM și PSI"
	description="Contact TCA SAFEWORK: ofertă SSM și PSI / SU în maximum 24 de ore. Telefon 0762 682 850 / 0763 693 715."
	jsonLd={{
		"@context": "https://schema.org",
		"@type": "ContactPage",
		name: "Contact TCA SAFEWORK",
		description: "Solicită oferta pentru serviciu extern SSM și PSI / situații de urgență.",
		url: Astro.url.href,
		mainEntity: {
			"@type": "Organization",
			name: "TCA SAFEWORK",
			telephone: ["+40-762-682-850", "+40-763-693-715"],
			email: "office@fiscontsrl.ro",
			address: {
				"@type": "PostalAddress",
				streetAddress: "Bd. Unirii nr. 64, Bloc K4, scara 4, et. 3",
				addressLocality: "București",
				addressCountry: "RO",
			},
		},
	}}
>
	<section class="page-hero">
		<div class="container reveal">
			<span class="eyebrow">Contact</span>
			<h1>Solicită oferta</h1>
			<p>
				Completați formularul sau ne sunați. În maximum 24 de ore primiți oferta exactă, fără obligații.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container contact-grid">
			<div class="reveal">
				<h2>Date de contact</h2>
				<ul class="contact-list">
					<li>
						<span>Telefon</span>
						<a href="tel:+40762682850">0762 682 850</a>
					</li>
					<li>
						<span>Telefon</span>
						<a href="tel:+40763693715">0763 693 715</a>
					</li>
					<li>
						<span>Email</span>
						<a href="mailto:office@fiscontsrl.ro">office@fiscontsrl.ro</a>
					</li>
					<li>
						<span>Adresă</span>
						<span class="contact-plain"
							>Bd. Unirii nr. 64, Bloc K4, scara 4, et. 3, București</span
						>
					</li>
					<li>
						<span>Facebook</span>
						<a href="https://www.facebook.com/profile.php?id=61591444305432" target="_blank" rel="noopener noreferrer"
							>TCA SAFEWORK</a
						>
					</li>
				</ul>
				<p class="note">
					Adresa și emailul sunt temporare (prin Fiscont), până avem datele proprii TCA SAFEWORK. Pentru
					ofertă ne ajută: domeniul de activitate, numărul de angajați și locația.
				</p>
			</div>

			<form class="contact-form reveal" id="formular" action={`mailto:office@fiscontsrl.ro`} method="post" enctype="text/plain">
				<h2>Formular ofertă</h2>
				<p class="form-intro">
					Completați formularul de mai jos și primiți oferta exactă în maximum 24 de ore.
				</p>
				<label>
					Nume și prenume
					<input type="text" name="nume" required autocomplete="name" placeholder="Nume Prenume" />
				</label>
				<label>
					Telefon
					<input type="tel" name="telefon" required autocomplete="tel" placeholder="07xx xxx xxx" />
				</label>
				<label>
					Email
					<input type="email" name="email" required autocomplete="email" placeholder="email@firma.ro" />
				</label>
				<label>
					Domeniu de activitate
					<input type="text" name="domeniu" required placeholder="Ex: construcții, comerț, producție" />
				</label>
				<label>
					Număr de angajați
					<input type="number" name="angajati" required min="1" placeholder="Ex: 12" />
				</label>
				<label>
					Locația
					<input type="text" name="locatie" required autocomplete="address-level2" placeholder="Oraș / județ" />
				</label>
				<label>
					Mesaj
					<textarea name="mesaj" rows="4" placeholder="Alte detalii utile (opțional)"></textarea>
				</label>
				<button class="btn btn-primary" type="submit">Trimite solicitarea</button>
				<p class="form-status" id="form-status" hidden></p>
			</form>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 3.5rem 0 1rem;
	}

	.page-hero h1 {
		font-size: clamp(2rem, 4.5vw, 3rem);
	}

	.page-hero p {
		max-width: 38rem;
		color: var(--color-muted);
		font-size: 1.08rem;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		gap: 3rem;
		align-items: start;
	}

	.contact-grid h2 {
		font-size: 1.45rem;
		margin-bottom: 1rem;
	}

	.contact-list {
		list-style: none;
		margin: 0 0 1.25rem;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.contact-list li {
		display: grid;
		gap: 0.2rem;
	}

	.contact-list span {
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--color-brown);
	}

	.contact-list a {
		font-size: 1.15rem;
		font-weight: 700;
		text-decoration: none;
		color: var(--color-ink);
	}

	.contact-list a:hover {
		color: var(--color-brown);
	}

	.contact-plain {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-ink);
		line-height: 1.45;
	}

	.note {
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.contact-form {
		display: grid;
		gap: 0.9rem;
		padding: 1.5rem;
		scroll-margin-top: calc(var(--header-h) + 1rem);
		background: rgba(255, 255, 255, 0.55);
		border: 1px solid rgba(110, 58, 40, 0.1);
		box-shadow: var(--shadow-soft);
	}

	.form-intro {
		margin: -0.25rem 0 0.35rem;
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.contact-form label {
		display: grid;
		gap: 0.35rem;
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--color-ink-soft);
	}

	.contact-form input,
	.contact-form textarea {
		width: 100%;
		padding: 0.75rem 0.85rem;
		border: 1px solid rgba(110, 58, 40, 0.18);
		border-radius: var(--radius);
		background: var(--color-white);
		font: inherit;
		color: var(--color-ink);
	}

	.contact-form input:focus,
	.contact-form textarea:focus {
		outline: 2px solid var(--color-sky);
		border-color: transparent;
	}

	.contact-form .btn {
		justify-self: start;
		margin-top: 0.25rem;
	}

	.form-status {
		margin: 0;
		font-size: 0.92rem;
		color: var(--color-brown);
		font-weight: 600;
	}

	@media (max-width: 800px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>

<script>
	const form = document.getElementById("formular") as HTMLFormElement | null;
	const status = document.getElementById("form-status");

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const nume = String(data.get("nume") || "").trim();
		const telefon = String(data.get("telefon") || "").trim();
		const email = String(data.get("email") || "").trim();
		const domeniu = String(data.get("domeniu") || "").trim();
		const angajati = String(data.get("angajati") || "").trim();
		const locatie = String(data.get("locatie") || "").trim();
		const mesaj = String(data.get("mesaj") || "").trim();

		const subject = encodeURIComponent(`Solicitare ofertă SSM/PSI — ${nume}`);
		const body = encodeURIComponent(
			[
				`Nume: ${nume}`,
				`Telefon: ${telefon}`,
				`Email: ${email}`,
				`Domeniu de activitate: ${domeniu}`,
				`Număr de angajați: ${angajati}`,
				`Locația: ${locatie}`,
				"",
				"Mesaj:",
				mesaj || "(fără mesaj)",
				"",
				"— Trimis de pe site-ul TCA SAFEWORK",
			].join("\n"),
		);

		window.location.href = `mailto:office@fiscontsrl.ro?subject=${subject}&body=${body}`;

		if (status) {
			status.hidden = false;
			status.textContent = "Se deschide clientul de e-mail. Poți trimite și sunând la numerele din stânga.";
		}
	});
</script>
