---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { company, companyAddress } from "../lib/company";
import { breadcrumbSchema } from "../lib/seo";

const base = import.meta.env.BASE_URL;
const siteUrl = new URL(base, Astro.site);
---

<BaseLayout
	title="Contact — ofertă SSM și PSI"
	description="Contact TCA SAFEWORK — cere oferta SSM și PSI / SU. Răspuns în maximum 24 de ore. Tel. 0762 682 850 / 0763 693 715, București."
	jsonLd={[
		{
			"@context": "https://schema.org",
			"@type": "ContactPage",
			name: "Contact TCA SAFEWORK",
			description: "Solicită oferta pentru serviciu extern SSM și PSI / situații de urgență.",
			url: new URL("contact/", siteUrl).href,
			mainEntity: {
				"@type": "Organization",
				name: company.legalName,
				taxID: company.cui,
				telephone: ["+40-762-682-850", "+40-763-693-715"],
				email: company.email,
				address: {
					"@type": "PostalAddress",
					streetAddress: company.street,
					addressLocality: company.city,
					addressRegion: company.sector,
					addressCountry: "RO",
				},
			},
		},
		breadcrumbSchema([
			{ name: "Acasă", url: siteUrl.href },
			{ name: "Contact", url: new URL("contact/", siteUrl).href },
		]),
	]}
>
	<section class="page-hero">
		<div class="container reveal">
			<Breadcrumbs items={[{ label: "Contact" }]} />
			<span class="eyebrow">Contact</span>
			<h1>Solicită oferta</h1>
			<p>
				Completează formularul sau sună-ne. În maximum 24 de ore primești oferta potrivită pentru compania ta,
				gratuit.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container contact-grid">
			<div class="reveal">
				<h2>Date de contact</h2>
				<ul class="contact-list">
					<li>
						<span>Telefon</span>
						<a href="tel:+40762682850">0762 682 850</a>
					</li>
					<li>
						<span>Telefon</span>
						<a href="tel:+40763693715">0763 693 715</a>
					</li>
					<li>
						<span>Email</span>
						<a href="mailto:office@tcasafework.ro">office@tcasafework.ro</a>
					</li>
					<li>
						<span>Sediu social</span>
						<span class="contact-plain">{companyAddress}</span>
					</li>
					<li>
						<span>Date firmă</span>
						<span class="contact-plain">{company.legalName}</span>
						<span class="contact-plain">CUI {company.cui} · {company.tradeRegister}</span>
					</li>
					<li>
						<span>Facebook</span>
						<a href="https://www.facebook.com/profile.php?id=61591444305432" target="_blank" rel="noopener noreferrer"
							>TCA SAFEWORK</a
						>
					</li>
				</ul>
			</div>

			<form class="contact-form reveal" id="formular" action="/contact.php" method="post">
				<h2>Formular ofertă</h2>
				<p class="form-intro">
					Completează formularul de mai jos și primești oferta exactă în cel mult 24 de ore.
				</p>
				<div class="hp" aria-hidden="true">
					<label>
						Website
						<input type="text" name="website" tabindex="-1" autocomplete="off" />
					</label>
				</div>
				<input type="hidden" name="form_ts" id="form_ts" value="" />
				<label>
					Nume și prenume
					<input type="text" name="nume" required autocomplete="name" maxlength="120" placeholder="Nume Prenume" />
				</label>
				<label>
					Telefon
					<input type="tel" name="telefon" required autocomplete="tel" maxlength="40" placeholder="07xx xxx xxx" />
				</label>
				<label>
					Email
					<input type="email" name="email" required autocomplete="email" maxlength="120" placeholder="email@firma.ro" />
				</label>
				<label>
					Domeniu de activitate
					<input type="text" name="domeniu" required maxlength="200" placeholder="Ex: construcții, comerț, producție" />
				</label>
				<label>
					Număr de angajați
					<input type="number" name="angajati" required min="1" max="999999" maxlength="10" placeholder="Ex: 12" />
				</label>
				<label>
					Locația
					<input type="text" name="locatie" required autocomplete="address-level2" maxlength="120" placeholder="Oraș / județ" />
				</label>
				<label>
					Mesaj
					<textarea name="mesaj" rows="4" maxlength="2000" placeholder="Alte detalii utile (opțional)"></textarea>
				</label>
				<label class="gdpr-label">
					<input type="checkbox" name="gdpr" value="1" required />
					<span>
						Sunt de acord cu prelucrarea datelor conform <a href={`${base}confidentialitate/`}>Politicii de confidențialitate</a>.
					</span>
				</label>
				<button class="btn btn-primary" type="submit">Trimite solicitarea</button>
				<p class="form-status" id="form-status" hidden></p>
			</form>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 3.5rem 0 1rem;
	}

	.page-hero h1 {
		font-size: clamp(2rem, 4.5vw, 3rem);
	}

	.page-hero p {
		max-width: 38rem;
		color: var(--color-muted);
		font-size: 1.08rem;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		gap: 3rem;
		align-items: start;
	}

	.contact-grid h2 {
		font-size: 1.45rem;
		margin-bottom: 1rem;
	}

	.contact-list {
		list-style: none;
		margin: 0 0 1.25rem;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.contact-list li {
		display: grid;
		gap: 0.2rem;
	}

	.contact-list span {
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--color-brown);
	}

	.contact-list a {
		font-size: 1.15rem;
		font-weight: 700;
		text-decoration: none;
		color: var(--color-ink);
	}

	.contact-list a:hover {
		color: var(--color-brown);
	}

	.contact-list .contact-plain {
		font-size: 1.05rem;
		font-weight: 600;
		letter-spacing: 0;
		text-transform: none;
		color: var(--color-ink);
		line-height: 1.45;
	}

	.note {
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.contact-form {
		position: relative;
		display: grid;
		gap: 0.9rem;
		padding: 1.5rem;
		scroll-margin-top: calc(var(--header-h) + 1rem);
		background: rgba(255, 255, 255, 0.55);
		border: 1px solid rgba(110, 58, 40, 0.1);
		box-shadow: var(--shadow-soft);
	}

	.form-intro {
		margin: -0.25rem 0 0.35rem;
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.contact-form label {
		display: grid;
		gap: 0.35rem;
		font-weight: 600;
		font-size: 0.9rem;
		color: var(--color-ink-soft);
	}

	.contact-form input,
	.contact-form textarea {
		width: 100%;
		padding: 0.75rem 0.85rem;
		border: 1px solid rgba(110, 58, 40, 0.18);
		border-radius: var(--radius);
		background: var(--color-white);
		font: inherit;
		color: var(--color-ink);
	}

	.contact-form input:focus,
	.contact-form textarea:focus {
		outline: 2px solid var(--color-sky);
		border-color: transparent;
	}

	.contact-form .btn {
		justify-self: start;
		margin-top: 0.25rem;
	}

	.hp {
		position: absolute;
		left: -10000px;
		width: 1px;
		height: 1px;
		overflow: hidden;
	}

	.contact-form label.gdpr-label {
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		gap: 0.65rem;
		font-weight: 500;
		font-size: 0.88rem;
		line-height: 1.45;
	}

	.contact-form label.gdpr-label input {
		width: 1.05rem;
		height: 1.05rem;
		margin: 0.15rem 0 0;
		padding: 0;
		flex: 0 0 auto;
	}

	.gdpr-label a {
		color: var(--color-brown);
		font-weight: 700;
	}

	.form-status {
		margin: 0;
		font-size: 0.92rem;
		color: var(--color-brown);
		font-weight: 600;
	}

	.form-status.is-success {
		color: #2f6b3a;
	}

	.form-status.is-error {
		color: var(--color-brown);
	}

	@media (max-width: 800px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>

<script>
	const form = document.getElementById("formular") as HTMLFormElement | null;
	const status = document.getElementById("form-status");
	const tsField = document.getElementById("form_ts") as HTMLInputElement | null;
	const submitBtn = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

	if (tsField) {
		tsField.value = String(Math.floor(Date.now() / 1000));
	}

	function showStatus(message: string, ok: boolean) {
		if (!status) return;
		status.hidden = false;
		status.textContent = message;
		status.classList.toggle("is-success", ok);
		status.classList.toggle("is-error", !ok);
	}

	form?.addEventListener("submit", async (event) => {
		event.preventDefault();
		if (!form) return;

		showStatus("Se trimite solicitarea…", true);
		if (submitBtn) submitBtn.disabled = true;

		try {
			const response = await fetch(form.action, {
				method: "POST",
				body: new FormData(form),
				headers: { Accept: "application/json" },
			});
			const payload = (await response.json()) as { ok?: boolean; message?: string };
			const ok = Boolean(payload.ok);
			showStatus(
				payload.message ||
					(ok
						? "Mesajul a fost trimis. Te contactăm în maximum 24 de ore."
						: "Mesajul nu a putut fi trimis. Încearcă din nou sau sună-ne."),
				ok,
			);
			if (ok) {
				form.reset();
				if (tsField) tsField.value = String(Math.floor(Date.now() / 1000));
			}
		} catch {
			showStatus("Mesajul nu a putut fi trimis. Încearcă din nou sau sună-ne.", false);
		} finally {
			if (submitBtn) submitBtn.disabled = false;
		}
	});
</script>
