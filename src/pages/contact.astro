---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
	title="Contact"
	description="Contactează SSM & SU Expert SafetyWork pentru servicii SSM și Situații de Urgență."
>
	<section class="page-hero">
		<div class="container reveal">
			<span class="eyebrow">Contact</span>
			<h1>Hai să vorbim</h1>
			<p>Spune-ne pe scurt ce ai nevoie. Revenim cu informații și pașii următori.</p>
		</div>
	</section>

	<section class="section">
		<div class="container contact-grid">
			<div class="reveal">
				<h2>Date de contact</h2>
				<ul class="contact-list">
					<li>
						<span>Telefon</span>
						<a href="tel:+40762682850">0762 682 850</a>
					</li>
					<li>
						<span>Telefon</span>
						<a href="tel:+40763693715">0763 693 715</a>
					</li>
					<li>
						<span>Facebook</span>
						<a href="https://www.facebook.com/profile.php?id=61591444305432" target="_blank" rel="noopener noreferrer"
							>SSM &amp; SU Expert SafetyWork</a
						>
					</li>
				</ul>
				<p class="note">
					Preferi un mesaj scris? Folosește formularul — se deschide în clientul tău de e-mail, gata de
					trimis.
				</p>
			</div>

			<form class="contact-form reveal" id="contact-form">
				<label>
					Nume
					<input type="text" name="name" required autocomplete="name" placeholder="Numele tău" />
				</label>
				<label>
					Telefon / e-mail
					<input
						type="text"
						name="contact"
						required
						autocomplete="email"
						placeholder="Cum te putem contacta"
					/>
				</label>
				<label>
					Mesaj
					<textarea name="message" rows="5" required placeholder="Cu ce te putem ajuta?"></textarea>
				</label>
				<button class="btn btn-primary" type="submit">Trimite solicitarea</button>
				<p class="form-status" id="form-status" hidden></p>
			</form>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 3.5rem 0 1rem;
	}

	.page-hero h1 {
		font-size: clamp(2rem, 4.5vw, 3rem);
	}

	.page-hero p {
		max-width: 36rem;
		color: var(--color-muted);
		font-size: 1.08rem;
	}

	.contact-grid {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 3rem;
		align-items: start;
	}

	.contact-grid h2 {
		font-size: 1.5rem;
		margin-bottom: 1.25rem;
	}

	.contact-list {
		list-style: none;
		margin: 0 0 1.5rem;
		padding: 0;
		display: grid;
		gap: 1rem;
	}

	.contact-list li {
		display: grid;
		gap: 0.2rem;
	}

	.contact-list span {
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		font-weight: 700;
		color: var(--color-brown);
	}

	.contact-list a {
		font-size: 1.15rem;
		font-weight: 700;
		text-decoration: none;
		color: var(--color-ink);
	}

	.contact-list a:hover {
		color: var(--color-brown);
	}

	.note {
		color: var(--color-muted);
		font-size: 0.95rem;
	}

	.contact-form {
		display: grid;
		gap: 1rem;
		padding: 1.5rem;
		background: rgba(255, 255, 255, 0.55);
		border: 1px solid rgba(110, 58, 40, 0.1);
		box-shadow: var(--shadow-soft);
	}

	.contact-form label {
		display: grid;
		gap: 0.4rem;
		font-weight: 600;
		font-size: 0.92rem;
		color: var(--color-ink-soft);
	}

	.contact-form input,
	.contact-form textarea {
		width: 100%;
		padding: 0.8rem 0.9rem;
		border: 1px solid rgba(110, 58, 40, 0.18);
		border-radius: var(--radius);
		background: var(--color-white);
		font: inherit;
		color: var(--color-ink);
	}

	.contact-form input:focus,
	.contact-form textarea:focus {
		outline: 2px solid var(--color-sky);
		border-color: transparent;
	}

	.contact-form .btn {
		justify-self: start;
		margin-top: 0.25rem;
	}

	.form-status {
		margin: 0;
		font-size: 0.92rem;
		color: var(--color-brown);
		font-weight: 600;
	}

	@media (max-width: 800px) {
		.contact-grid {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}
</style>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	const status = document.getElementById("form-status");

	form?.addEventListener("submit", (event) => {
		event.preventDefault();
		const data = new FormData(form);
		const name = String(data.get("name") || "").trim();
		const contact = String(data.get("contact") || "").trim();
		const message = String(data.get("message") || "").trim();

		const subject = encodeURIComponent(`Solicitare informații — ${name}`);
		const body = encodeURIComponent(
			`Nume: ${name}\nContact: ${contact}\n\nMesaj:\n${message}\n\n— Trimis de pe site-ul Expert SafetyWork`,
		);

		// Placeholder până avem adresă oficială / Formspree
		window.location.href = `mailto:contact@expertsafetywork.ro?subject=${subject}&body=${body}`;

		if (status) {
			status.hidden = false;
			status.textContent = "Se deschide clientul de e-mail. Poți trimite și sunând la numerele din stânga.";
		}
	});
</script>
