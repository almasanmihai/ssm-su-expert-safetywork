---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const services = [
	{
		title: "Securitate și sănătate în muncă",
		text: "Evaluarea riscurilor, instruirea angajaților și documentația necesară pentru un sistem SSM clar și actualizat.",
	},
	{
		title: "Situații de urgență",
		text: "Pregătire operațională: responsabilități, proceduri, spații de adăpostire și măsuri de protecție pentru personal.",
	},
	{
		title: "Audit și evaluare de risc",
		text: "Identificăm riscurile reale din activitate și propunem măsuri concrete de reducere și control.",
	},
	{
		title: "Planuri de intervenție",
		text: "Planuri și proceduri adaptate spațiului, activității și modului de lucru al companiei tale.",
	},
	{
		title: "Formare personal și coordonare SU",
		text: "Instruiri, exerciții și coordonare pentru ca echipa să știe ce are de făcut când apare o alertă.",
	},
	{
		title: "Conformare legislativă și suport operațional",
		text: "Te sprijinim să rămâi aliniat cerințelor legale, fără să pierzi focusul pe activitatea de bază.",
	},
];
---

<BaseLayout
	title="Servicii"
	description="Servicii externe SSM / SU: evaluare de risc, planuri de intervenție, formare personal și conformare legislativă."
>
	<section class="page-hero">
		<div class="container reveal">
			<span class="eyebrow">Servicii</span>
			<h1>Servicii externe SSM / SU</h1>
			<p>
				Soluții practice pentru protecția angajaților și reducerea riscurilor operaționale — de la documentație
				la pregătire în situații de urgență.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<ol class="service-list">
				{
					services.map((service, index) => (
						<li class="reveal" style={`transition-delay: ${index * 60}ms`}>
							<span class="idx">{String(index + 1).padStart(2, "0")}</span>
							<div>
								<h2>{service.title}</h2>
								<p>{service.text}</p>
							</div>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="section">
		<div class="container split reveal">
			<div>
				<span class="eyebrow">SSM + SU &amp; PSI</span>
				<h2>Clar, organizat, conform</h2>
				<p>
					<strong>SSM:</strong> evaluarea riscurilor, instruirea angajaților și documentație.
				</p>
				<p>
					<strong>SU &amp; PSI:</strong> planuri, instruiri, exerciții și măsuri de prevenție.
				</p>
			</div>
			<a class="btn btn-primary" href={`${base}contact`}>Solicită informații</a>
		</div>
	</section>
</BaseLayout>

<style>
	.page-hero {
		padding: 3.5rem 0 1rem;
	}

	.page-hero h1 {
		font-size: clamp(2rem, 4.5vw, 3rem);
		max-width: 16ch;
	}

	.page-hero p {
		max-width: 40rem;
		color: var(--color-muted);
		font-size: 1.08rem;
	}

	.service-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0;
	}

	.service-list li {
		display: grid;
		grid-template-columns: 4rem 1fr;
		gap: 1rem;
		padding: 1.6rem 0;
		border-top: 1px solid rgba(110, 58, 40, 0.12);
	}

	.service-list li:last-child {
		border-bottom: 1px solid rgba(110, 58, 40, 0.12);
	}

	.idx {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.25rem;
		color: var(--color-gold);
		line-height: 1.2;
	}

	.service-list h2 {
		font-size: 1.25rem;
		margin-bottom: 0.4rem;
	}

	.service-list p {
		margin: 0;
		color: var(--color-muted);
		max-width: 46rem;
	}

	.split {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
		padding: 2rem;
		background: linear-gradient(135deg, rgba(167, 223, 252, 0.28), rgba(255, 222, 89, 0.22));
		border: 1px solid rgba(110, 58, 40, 0.08);
	}

	.split h2 {
		font-size: clamp(1.6rem, 3vw, 2.1rem);
	}

	.split p {
		color: var(--color-ink-soft);
	}

	@media (max-width: 560px) {
		.service-list li {
			grid-template-columns: 3rem 1fr;
		}
	}
</style>
