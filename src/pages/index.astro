---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const highlights = [
	"Întocmire documentație completă SSM",
	"Reprezentare în caz de control",
	"Dosar PSI complet și plan de evacuare",
	"Documentație situații de urgență (Legea 307/2006 și 481/2004)",
	"Evaluarea riscurilor pe posturi de lucru",
	"Instruiri și asistență de specialitate",
];
---

<BaseLayout
	title="Acasă"
	description="Serviciu extern SSM (abilitat ITM București) și PSI / SU — un singur abonament, un singur contract, un singur om de contact."
>
	<section class="hero">
		<div class="hero-media" aria-hidden="true">
			<img
				src={`${base}images/hero-safety.jpg`}
				alt=""
				width="2000"
				height="1333"
				fetchpriority="high"
			/>
		</div>
		<div class="hero-overlay" aria-hidden="true"></div>
		<div class="container hero-content">
			<p class="hero-brand">SSM &amp; SU Expert SafetyWork</p>
			<h1>Un singur furnizor pentru SSM, PSI / SU</h1>
			<p class="hero-lead">
				Serviciu extern SSM (abilitat de către I.T.M. București) și PSI. Un singur abonament, un singur
				contract, un singur om de contact — iar documentele nu se contrazic între ele la control.
			</p>
			<div class="hero-actions">
				<a class="btn btn-primary" href={`${base}contact/`}>Solicită oferta</a>
				<a class="btn btn-secondary" href={`${base}servicii/`}>Vezi serviciile</a>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container">
			<div class="section-head reveal">
				<span class="eyebrow">De ce un singur partener</span>
				<h2>Nu mai jonglați cu doi-trei furnizori</h2>
				<p>
					Majoritatea firmelor lucrează cu unul pentru SSM și altul pentru PSI / SU. La Expert SafetyWork
					primiți totul într-un singur abonament — clar, organizat și pregătit pentru control.
				</p>
			</div>

			<ul class="value-list reveal">
				{
					highlights.map((item) => (
						<li>
							<strong>{item}</strong>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="section band">
		<div class="container band-inner reveal">
			<div>
				<span class="eyebrow light">Preluare</span>
				<h2>Taxă unică de 900 lei</h2>
				<p>
					Întocmirea documentației complete SSM și PSI la preluare se achită o singură dată, indiferent de
					numărul de salariați. Apoi, abonament lunar complet — SSM + PSI (situații de urgență), instruiri și
					asistență.
				</p>
			</div>
			<a class="btn btn-primary" href={`${base}contact/`}>Întreabă-ne</a>
		</div>
	</section>

	<section class="section">
		<div class="container reveal">
			<div class="section-head">
				<span class="eyebrow">Cost</span>
				<h2>De ce externalizarea SSM costă mai puțin decât un angajat intern</h2>
				<p>
					Un lucrător desemnat intern înseamnă salariu, cursuri de specializare și răspundere concentrată pe
					un singur om — care poate pleca oricând. Externalizarea către o firmă de servicii SSM abilitată
					înseamnă o echipă întreagă de specialiști, la o fracțiune din cost, cu răspundere contractuală și
					continuitate garantată. Pentru firmele cu până la 50 de angajați, externalizarea SSM și PSI este
					soluția standard din practică.
				</p>
			</div>
		</div>
	</section>

	<section class="section steps-section">
		<div class="container">
			<div class="section-head reveal">
				<span class="eyebrow">Colaborare</span>
				<h2>Cum începem — 3 pași</h2>
			</div>
			<ol class="steps reveal">
				<li>
					<strong>Ne spuneți câți angajați aveți</strong>
					<span>Ne sunați. În maximum 24 de ore primiți oferta exactă, fără obligații.</span>
				</li>
				<li>
					<strong>Preluăm tot ce există</strong>
					<span
						>Analizăm documentația existentă, identificăm ce lipsește și elaborăm tot ce cere legislația
						pentru activitatea dumneavoastră.</span
					>
				</li>
				<li>
					<strong>Firma e acoperită permanent</strong>
					<span
						>Instruiri la termen, documente actualizate la orice modificare legislativă. La control, suntem
						acolo!</span
					>
				</li>
			</ol>
		</div>
	</section>

	<section class="section">
		<div class="container cta-block reveal">
			<div>
				<h2>Completați datele sau ne sunați</h2>
				<p>În maximum 24 de ore primiți oferta exactă, fără obligații.</p>
			</div>
			<a class="btn btn-outline" href={`${base}contact/`}>Contactează-ne</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: calc(100svh - var(--header-h));
		display: grid;
		align-items: end;
		overflow: hidden;
		color: var(--color-white);
	}

	.hero-media {
		position: absolute;
		inset: 0;
	}

	.hero-media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 35%;
		transform: scale(1.02);
		animation: heroDrift 18s var(--ease) infinite alternate;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(105deg, rgba(26, 22, 20, 0.88) 0%, rgba(26, 22, 20, 0.62) 48%, rgba(26, 22, 20, 0.28) 100%),
			linear-gradient(180deg, rgba(26, 22, 20, 0.25) 0%, transparent 35%, rgba(26, 22, 20, 0.45) 100%);
	}

	@keyframes heroDrift {
		from {
			transform: scale(1.02) translate3d(0, 0, 0);
		}
		to {
			transform: scale(1.08) translate3d(-1.5%, -1%, 0);
		}
	}

	.hero-content {
		position: relative;
		z-index: 1;
		padding: 5rem 0 4.5rem;
		max-width: 44rem;
		animation: heroIn 0.9s var(--ease) both;
	}

	@keyframes heroIn {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.hero-brand {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: clamp(1.05rem, 2.2vw, 1.35rem);
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--color-yellow);
		margin-bottom: 1rem;
	}

	.hero h1 {
		font-size: clamp(2.1rem, 5.2vw, 3.6rem);
		margin-bottom: 1rem;
		max-width: 16ch;
	}

	.hero-lead {
		font-size: 1.08rem;
		color: rgba(255, 255, 255, 0.86);
		max-width: 42ch;
		margin-bottom: 1.75rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.85rem;
	}

	.value-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem 2rem;
	}

	.value-list li {
		padding-left: 1.25rem;
		border-left: 3px solid var(--color-gold);
	}

	.value-list strong {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 700;
		color: var(--color-ink);
	}

	.band {
		background: linear-gradient(120deg, #1a1614 0%, #3d2a22 55%, #5a4028 100%);
		color: var(--color-white);
	}

	.band .eyebrow.light {
		color: var(--color-sky);
	}

	.band h2 {
		color: var(--color-white);
	}

	.band p {
		color: rgba(255, 255, 255, 0.78);
		max-width: 42rem;
	}

	.band-inner {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 2rem;
		flex-wrap: wrap;
	}

	.steps {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 1.5rem;
		counter-reset: step;
	}

	.steps li {
		display: grid;
		gap: 0.35rem;
		padding-left: 3.5rem;
		position: relative;
		counter-increment: step;
	}

	.steps li::before {
		content: counter(step);
		position: absolute;
		left: 0;
		top: 0;
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		background: var(--color-gold);
		color: var(--color-ink);
		font-family: var(--font-display);
		font-weight: 800;
	}

	.steps strong {
		font-family: var(--font-display);
		font-size: 1.15rem;
	}

	.steps span {
		color: var(--color-muted);
	}

	.cta-block {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
		padding: 2rem 0;
		border-top: 1px solid rgba(110, 58, 40, 0.15);
		border-bottom: 1px solid rgba(110, 58, 40, 0.15);
	}

	.cta-block h2 {
		margin-bottom: 0.35rem;
	}

	.cta-block p {
		color: var(--color-muted);
		margin: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-media img {
			animation: none;
			transform: none;
		}

		.hero-content {
			animation: none;
		}
	}

	@media (max-width: 720px) {
		.value-list {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.hero-content {
			padding: 3.5rem 0 3rem;
		}

		.hero h1 {
			max-width: none;
		}
	}
</style>
