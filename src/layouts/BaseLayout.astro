---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { company } from "../lib/company";
import "../styles/global.css";

interface Props {
	title: string;
	description?: string;
	image?: string;
	/** If true, `title` is used as-is (no brand suffix). */
	absoluteTitle?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	robots?: string;
	preloadImage?: string;
	canonicalPath?: string;
}

const {
	title,
	description = "Serviciu extern SSM abilitat ITM București și PSI / situații de urgență. Un singur abonament pentru documentație, instruiri și asistență la control.",
	image = "images/og-cover.jpg?v=3",
	absoluteTitle = false,
	jsonLd,
	robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
	preloadImage,
	canonicalPath,
} = Astro.props;

const siteName = "TCA SAFEWORK";
const fullTitle = absoluteTitle ? title : `${title} | ${siteName}`;
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site);
const base = import.meta.env.BASE_URL;
const ogImage = new URL(image.replace(/^\//, ""), siteUrl);
const ogImageAlt = "Consultanți SSM pe șantier — verificare documentație, cu căști și veste reflectorizante";
const orgDescription =
	"Serviciu extern SSM abilitat ITM București și PSI / situații de urgență. Un singur abonament pentru documentație, instruiri și asistență la control.";
const serviciiUrl = new URL("servicii/", siteUrl).href;

const organizationSchema = {
	"@context": "https://schema.org",
	"@type": "ProfessionalService",
	"@id": new URL("#organizatie", siteUrl).href,
	name: siteName,
	legalName: company.legalName,
	taxID: company.cui,
	identifier: {
		"@type": "PropertyValue",
		name: "Număr de ordine în Registrul Comerțului",
		value: company.tradeRegister,
	},
	alternateName: ["SSM & SU Expert SafetyWork", "TCA Safe Work"],
	url: siteUrl.href,
	logo: {
		"@type": "ImageObject",
		url: new URL("logo.png", siteUrl).href,
		width: 512,
		height: 512,
	},
	image: ogImage.href,
	description: orgDescription,
	telephone: ["+40-762-682-850", "+40-763-693-715"],
	email: "office@tcasafework.ro",
	address: {
		"@type": "PostalAddress",
		streetAddress: company.street,
		addressLocality: company.city,
		addressRegion: company.sector,
		addressCountry: "RO",
	},
	areaServed: [
		{ "@type": "City", name: "București" },
		{ "@type": "Country", name: "România" },
	],
	serviceType: [
		"Serviciu extern SSM",
		"PSI / situații de urgență",
		"Consultanță protecție civilă",
	],
	sameAs: ["https://www.facebook.com/profile.php?id=61591444305432"],
	priceRange: "$$",
	currenciesAccepted: "RON",
	paymentAccepted: "Cash, Bank Transfer",
	availableLanguage: "Romanian",
	knowsAbout: [
		"Securitate și sănătate în muncă",
		"Prevenirea și stingerea incendiilor",
		"Situații de urgență",
		"Protecție civilă",
		"Legea 319/2006",
	],
	contactPoint: {
		"@type": "ContactPoint",
		telephone: "+40-762-682-850",
		contactType: "sales",
		areaServed: "RO",
		availableLanguage: ["Romanian"],
		email: "office@tcasafework.ro",
	},
	hasOfferCatalog: {
		"@type": "OfferCatalog",
		name: "Servicii SSM și PSI",
		itemListElement: [
			{
				"@type": "Offer",
				itemOffered: {
					"@type": "Service",
					name: "Serviciu extern SSM",
					url: serviciiUrl,
				},
			},
			{
				"@type": "Offer",
				itemOffered: {
					"@type": "Service",
					name: "PSI / situații de urgență",
					url: serviciiUrl,
				},
			},
			{
				"@type": "Offer",
				itemOffered: {
					"@type": "Service",
					name: "Consultanță protecție civilă",
					url: serviciiUrl,
				},
			},
		],
	},
};

const websiteSchema = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": new URL("#website", siteUrl).href,
	name: siteName,
	url: siteUrl.href,
	inLanguage: "ro-RO",
	description: orgDescription,
	publisher: { "@id": new URL("#organizatie", siteUrl).href },
};

const webPageSchema = {
	"@context": "https://schema.org",
	"@type": "WebPage",
	"@id": `${canonicalURL.href}#webpage`,
	url: canonicalURL.href,
	name: fullTitle,
	description,
	inLanguage: "ro-RO",
	isPartOf: { "@id": new URL("#website", siteUrl).href },
	about: { "@id": new URL("#organizatie", siteUrl).href },
	primaryImageOfPage: ogImage.href,
};

const schemas = [
	organizationSchema,
	websiteSchema,
	webPageSchema,
	...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];
---

<!doctype html>
<html lang="ro">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href={`${base}favicon.png`} />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="apple-touch-icon" href={`${base}logo.png`} />
		<link rel="manifest" href={`${base}site.webmanifest`} />
		<link rel="sitemap" type="application/xml" href={`${base}sitemap-index.xml`} />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="serviciu extern SSM, SSM București, PSI, situații de urgență, ITM, protecție civilă, securitate și sănătate în muncă, TCA SAFEWORK"
		/>
		<meta name="author" content="TCA SAFEWORK" />
		<meta name="robots" content={robots} />
		<meta name="googlebot" content={robots} />
		<meta name="application-name" content={siteName} />
		<meta name="geo.region" content="RO-B" />
		<meta name="geo.placename" content="București" />
		<meta name="format-detection" content="telephone=yes" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="alternate" hreflang="ro" href={canonicalURL} />
		<link rel="alternate" hreflang="x-default" href={canonicalURL} />

		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="ro_RO" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/jpeg" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<meta name="theme-color" content="#1a1614" />

		{
			preloadImage && (
				<link rel="preload" as="image" href={preloadImage} type="image/webp" fetchpriority="high" />
			)
		}

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
			rel="stylesheet"
		/>
		<title>{fullTitle}</title>

		{
			schemas.map((schema) => (
				<script type="application/ld+json" set:html={JSON.stringify(schema)} />
			))
		}
	</head>
	<body>
		<a class="skip-link" href="#continut">Sari la conținut</a>
		<Header />
		<main class="site-main" id="continut">
			<slot />
		</main>
		<Footer />
		<script>
			const observer = new IntersectionObserver(
				(entries) => {
					entries.forEach((entry) => {
						if (entry.isIntersecting) {
							entry.target.classList.add("is-visible");
							observer.unobserve(entry.target);
						}
					});
				},
				{ threshold: 0.15, rootMargin: "0px 0px -40px 0px" },
			);

			document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
		</script>
	</body>
</html>
